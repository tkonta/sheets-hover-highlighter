{
  "manifest_version": 3,
  "name": "Sheets Hover Highlighter",
  "version": "",
  "description": "Google スプレッドシートで、マウスポインタの下にあるセルの行と列を強調表示する",
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
